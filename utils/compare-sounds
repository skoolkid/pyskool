#!/usr/bin/env bash

if [ -z "$SKOOLKIT_HOME" ]; then
  echo "Error: SKOOLKIT_HOME not defined."
  exit 1
fi
if [ ! -d "$SKOOLKIT_HOME" ]; then
  echo "Error: directory not found: $SKOOLKIT_HOME"
  exit 1
fi
ANALYSE_WAV=$SKOOLKIT_HOME/tools/analyse-wav.py

if [ $# -ne 2 ]; then
  echo "Usage: $(basename $0) OLDDIR NEWDIR" 1>&2
  exit 1
fi

olddir=$1
newdir=$2
for d in "$olddir" "$newdir"; do
  if [ "$d" != "." ] && [ ! -d "$d" ]; then
    echo "$d: directory not found" 1>&2
    exit 1
  fi
done

for d in back_to_skool{,_daze} common ezad_looks skool_daze{,_take_too}; do
  for oldwav in $olddir/$d/*.wav; do
    newwav=$newdir/$d/$(basename $oldwav)
    if ! cmp -s $oldwav $newwav; then
      $ANALYSE_WAV --diff $oldwav $newwav
    fi
  done
done

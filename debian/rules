#!/usr/bin/make -f

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	mv debian/pyskool/usr/bin debian/pyskool/usr/games
	install -Dpm 644 icon.png debian/pyskool/usr/share/icons/hicolor/32x32/apps/ca.pyskool.Pyskool.png

override_dh_compress:
	dh_compress --exclude=changelog.html --exclude=.js

override_dh_installchangelogs:
	dh_installchangelogs -Xchanges.txt
